{
  "name": "@lcmp/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "setup:owner": "tsx src/setup-owner.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "arabic-reshaper": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "bidi-js": "^1.0.3",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "nodemailer": "^10.1.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/pdfkit": "^0.17.0",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.12"
  }
}