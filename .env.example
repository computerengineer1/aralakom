# =====================================================================
# Lebanon Contracting Management Platform - environment configuration
# Copy to .env and fill in. NEVER commit real secrets.
# =====================================================================

# --- Runtime ---
NODE_ENV=development            # development | production
PORT=8080                       # backend HTTP port (also serves built web app in production)
LOG_LEVEL=info
TRUST_PROXY=false               # set to true ONLY behind a correctly configured reverse proxy
APP_BASE_URL=http://localhost:8080

# --- Database (least-privilege app role; NOT the postgres superuser) ---
DATABASE_URL=postgres://lcmp:CHANGE_ME@127.0.0.1:5432/lcmp

# --- Security ---
SESSION_SECRET=replace-with-64-random-hex-chars   # used to sign session ids
COOKIE_SECURE=false             # MUST be true in production (HTTPS)
COOKIE_SAMESITE=lax             # lax | strict
CSRF_COOKIE_SECURE=false        # MUST be true in production
PASSWORD_RESET_TTL_MINUTES=30
SESSION_TTL_HOURS=12
OWNER_SETUP_TOKEN=              # one-time token required by `npm run setup:owner` (generate your own)

# --- CORS (only needed if web app is served from a different origin) ---
CORS_ORIGINS=                   # comma separated allowlist, e.g. https://app.example.com

# --- Email (SMTP). If SMTP_HOST is empty, emails are written to data/outbox (dev fallback). ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Lebanon Contracting <no-reply@example.com>"

# --- Files ---
UPLOAD_DIR=./data/uploads       # MUST be outside the public web root in production
MAX_UPLOAD_MB=10

# --- Public web build location (served by the backend in production) ---
WEB_DIST=../web/dist

# --- Demo/seed data ---
ALLOW_DEMO_SEED=false           # seed script refuses to run unless this is true
